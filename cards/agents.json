{
  "type": "AdaptiveCard",
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "TextBlock",
      "text": "Student Success Assistant",
      "weight": "Bolder",
      "size": "Large"
    },
    {
      "type": "TextBlock",
      "text": "Choose who you'd like to work with:",
      "wrap": true,
      "spacing": "Small"
    },

    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "🗂 Archivist",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "Retrieve knowledge, policies, and historical records.",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Work with Archivist",
              "data": {
                "agent": "archivist"
              }
            }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "📊 Executive",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "Get insights, summaries, and decision support.",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Work with Executive",
              "data": {
                "agent": "executive"
              }
            }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "🎯 Career Coach",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "Get career advice, resume help, and guidance.",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Work with Career Coach",
              "data": {
                "agent": "career_coach"
              }
            }
          ]
        }
      ]
    },

    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Small",
      "items": [
        {
          "type": "TextBlock",
          "text": "🛎 Front Desk",
          "weight": "Bolder"
        },
        {
          "type": "TextBlock",
          "text": "General help, triage, and quick answers.",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Work with Front Desk",
              "data": {
                "agent": "front_desk"
              }
            }
          ]
        }
      ]
    }
  ]
}
