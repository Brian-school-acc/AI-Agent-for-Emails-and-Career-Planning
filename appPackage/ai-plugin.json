{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.1/schema.json",
  "schema_version": "v2.1",
  "namespace": "StudentSuccessEmails",
  "name_for_human": "Nylas Email Retriever",
  "description_for_model": "Retrieves recent emails from a student inbox.",
  "description_for_human": "Retrieves recent emails from a student inbox.",
  "functions": [
    {
      "name": "retrieve_student_emails",
      "description": "Searches and retrieves recent emails using semantic keywords.",
      "capabilities": {
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "$.search_query",
            "subtitle": "$.count"
          },
          "static_template": {
            "type": "AdaptiveCard",
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "## 📧 Found ${count} emails for '${search_query}'",
                "wrap": true,
                "weight": "Bolder",
                "size": "Medium"
              },
              {
                "type": "Container",
                "$data": "${emails}",
                "separator": true,
                "spacing": "Medium",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "**From:** ${sender}",
                    "wrap": true,
                    "size": "Small"
                  },
                  {
                    "type": "TextBlock",
                    "text": "${subject}",
                    "wrap": true,
                    "weight": "Bolder"
                  },
                  {
                    "type": "TextBlock",
                    "text": "${snippet}",
                    "wrap": true,
                    "isSubtle": true,
                    "size": "Small"
                  },
                  {
                    "type": "ActionSet",
                    "actions": [
                      {
                        "type": "Action.Submit",
                        "title": "Summarize Thread",
                        "data": {
                          "action": "summarize_email",
                          "message_id": "${message_id}"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
